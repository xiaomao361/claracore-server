# 网关（bosun）登记该服务时填写的上游凭据；监听非回环地址时必填
CLARACORE_TOKEN=
CLARACORE_ADDR=127.0.0.1:9830
CLARACORE_DB=claracore.db

# 可选：语义检索。不设 PROVIDER 则只做文本检索
CLARACORE_EMBEDDING_PROVIDER=ollama
CLARACORE_EMBEDDING_URL=http://127.0.0.1:11434
CLARACORE_EMBEDDING_MODEL=bge-m3
CLARACORE_EMBEDDING_API_KEY=

# 仅本机调试：请求不带 X-Bosun-User 时使用的身份
CLARACORE_DEV_USER=

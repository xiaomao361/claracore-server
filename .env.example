# ClaraCore Server 配置模板
#
# 复制为 .env 并填入真实值。.env 已在 .gitignore 中，绝不提交。
# 所有环境变量只在 internal/config 包读取，其他任何位置禁止 os.Getenv
# （见 docs/05-code-structure.md §6.3）

# ---- 服务 ----
CCS_ADDR=127.0.0.1:51890
CCS_ENV=development

# ---- MySQL（必需，8.0+）----
# 需要 ngram 全文解析器、CTE、JSON 函数
CCS_MYSQL_HOST=192.168.3.200
CCS_MYSQL_PORT=3316
CCS_MYSQL_USER=claracore
CCS_MYSQL_PASSWORD=
CCS_MYSQL_DATABASE=claracore_server

# ---- Redis（可选）----
# 留空则全部降级为内存/数据库实现，系统功能完整
# 见 docs/01-architecture.md §6.1
CCS_REDIS_ADDR=192.168.3.200:6381
CCS_REDIS_PASSWORD=
CCS_REDIS_PREFIX=ccs:

# ---- Embedding（外部 HTTP 服务，服务端不做本地推理）----
# provider: ollama | openai-compatible | disabled
CCS_EMBEDDING_PROVIDER=ollama
CCS_EMBEDDING_BASE_URL=http://127.0.0.1:11434
CCS_EMBEDDING_MODEL=
CCS_EMBEDDING_API_KEY=

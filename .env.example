# ClaraCore Server 配置模板
#
# 复制为 .env 并填入真实值。.env 已在 .gitignore 中，绝不提交。
# 所有环境变量只在 internal/config 包读取，其他任何位置禁止 os.Getenv
# （见 docs/05-code-structure.md §6.3）
# 非空的整数、布尔值和小数会严格解析；拼写错误或超出安全范围时服务拒绝启动。
# .env 中缺少等号、非法/重复变量名或未闭合引号同样会直接报出行号。

# ---- 服务 ----
CCS_ADDR=127.0.0.1:51890
CCS_ENV=development
# 多实例验收时为每个实例配置不同的公开安全标签（例如 ccs-a / ccs-b）；单实例可留空。
CCS_INSTANCE_ID=
# SIGTERM 后先停止 readiness 并拒绝新请求，再等待摘流后关闭 listener。
CCS_SHUTDOWN_DRAIN_SEC=5
# Listener 自身的资源边界；即使 nginx 被绕过或误配也继续生效。
CCS_HTTP_READ_HEADER_TIMEOUT_SEC=10
CCS_HTTP_READ_TIMEOUT_SEC=30
CCS_HTTP_WRITE_TIMEOUT_SEC=300
CCS_HTTP_IDLE_TIMEOUT_SEC=120
CCS_HTTP_MAX_HEADER_BYTES=65536
# Web 只接受 urlencoded 表单；MCP SDK 对 JSON/SSE 请求独立限制正文大小。
CCS_WEB_MAX_FORM_BYTES=1048576
# 团队可移植导出先在本机临时文件中完整生成再下载，限制单次临时磁盘占用。
CCS_EXPORT_MAX_BYTES=1073741824
CCS_MCP_MAX_BODY_BYTES=4194304
# 认证后先按 agent、再按租户合计计数；token 轮换或新增 agent 均不能绕过对应预算。
# 租户预算不得小于单 agent 预算；Redis 可用时两层都跨实例共享。
CCS_MCP_RATE_LIMIT=300
CCS_MCP_TENANT_RATE_LIMIT=3000
CCS_MCP_RATE_WINDOW_SEC=60
# 可选的 Prometheus 0.0.4 文本端点；只允许数字 loopback 地址，且不走公网 nginx。
CCS_METRICS_ADDR=127.0.0.1:51892

# ---- MySQL（必需，8.0+）----
# 需要 ngram 全文解析器、CTE、JSON 函数
CCS_MYSQL_HOST=127.0.0.1
CCS_MYSQL_PORT=3316
CCS_MYSQL_USER=claracore
CCS_MYSQL_PASSWORD=
CCS_MYSQL_DATABASE=claracore_server
# disabled | verify-full。production 连接非 loopback MySQL 时必须 verify-full。
# CA 留空使用系统信任根；CERT/KEY 是可选 mTLS 对，私钥必须 0600。
CCS_MYSQL_TLS_MODE=disabled
CCS_MYSQL_TLS_CA_FILE=
CCS_MYSQL_TLS_CERT_FILE=
CCS_MYSQL_TLS_KEY_FILE=
CCS_MYSQL_TLS_SERVER_NAME=
# 连接池上限 1..10000；系统状态页显示实时占用与累计等待。
CCS_MYSQL_MAX_OPEN_CONNS=25
CCS_MYSQL_MAX_IDLE_CONNS=5
CCS_MYSQL_CONN_MAX_LIFETIME_SEC=1800

# ---- Redis（可选）----
# 留空则全部降级为内存/数据库实现，系统功能完整
# 见 docs/01-architecture.md §6.1
CCS_REDIS_ADDR=127.0.0.1:6379
CCS_REDIS_PASSWORD=
CCS_REDIS_PREFIX=ccs:
# production 连接非 loopback Redis 时必须验证 TLS 服务端身份；字段语义同 MySQL。
CCS_REDIS_TLS_MODE=disabled
CCS_REDIS_TLS_CA_FILE=
CCS_REDIS_TLS_CERT_FILE=
CCS_REDIS_TLS_KEY_FILE=
CCS_REDIS_TLS_SERVER_NAME=
# Redis 承担共享缓存、短索引租约与多实例登录/MCP 限流；故障时仍退回有界进程内保护
CCS_REDIS_TIMEOUT_MS=500

# ---- Embedding（外部 HTTP 服务，服务端不做本地推理）----
# provider: ollama | openai-compatible | disabled
# disabled 时不入索引队列，检索退化成中文全文匹配，系统功能完整
CCS_EMBEDDING_PROVIDER=ollama
CCS_EMBEDDING_BASE_URL=http://127.0.0.1:11434
# production 中非 loopback Embedding 必须使用 HTTPS，避免团队正文和 API key 明文传输。
# 模型名会原样写进 embeddings.model 列，是换模型灰度重建的依据，不可留空
CCS_EMBEDDING_MODEL=bge-m3
CCS_EMBEDDING_API_KEY=
# 单次批量调用上限，也是索引 worker 卡住的上限
CCS_EMBEDDING_TIMEOUT_SEC=30
# 后台索引 worker 的节奏。间隔决定「刚写完的内容多久后能被语义检索到」
CCS_EMBEDDING_INDEX_INTERVAL_SEC=5
CCS_EMBEDDING_INDEX_BATCH=32
# 进程内有界 LRU；0 关闭。配置 Redis 后会叠加共享缓存，供多实例与重启复用。
CCS_EMBEDDING_CACHE_ENTRIES=1024
CCS_EMBEDDING_CACHE_TTL_SEC=86400

# 自动上下文只做确定性预筛；终端 Agent 的模型负责最终相关性判断。
# 默认值按 bge-m3 的项目评估集校准，替换 embedding 模型后应重跑评估再调整。
CCS_AUTO_CONTEXT_MIN_SCORE=0.55
CCS_AUTO_CONTEXT_MIN_MARGIN=0.03

# ---- Atlas 外部活源（可选，只读索引镜像）----
# 留空 URL 即关闭。正文只在同步时进入内存用于 embedding，不写入 ClaraCore 数据库。
# 启用时必须同时启用 Embedding，并把来源挂到一个明确的团队/项目空间。
CCS_ATLAS_MCP_URL=
# production 中非 loopback Atlas 必须使用 HTTPS，即使来源不需要 token，正文仍属于敏感数据。
CCS_ATLAS_MCP_TOKEN=
CCS_ATLAS_SYSTEM=
CCS_ATLAS_SOURCE_NAME=atlas-docs
CCS_ATLAS_SPACE_ID=
# worker 启动即同步，之后按此周期重跑；整轮超时后保留上一版可用镜像。
CCS_ATLAS_SYNC_INTERVAL_SEC=900
CCS_ATLAS_SYNC_TIMEOUT_SEC=600
# 单次 MCP 请求与响应边界。
CCS_ATLAS_TIMEOUT_SEC=30
CCS_ATLAS_PAGE_SIZE=100
CCS_ATLAS_MAX_WIRE_BYTES=8388608
CCS_ATLAS_MAX_BODY_BYTES=2097152

# ---- Web 治理面 ----
# 发给用户复制的 MCP 连接地址。留空则用监听地址拼一个（仅本地开发够用）；
# nginx 后面的部署必须显式配置；production 环境只接受 https
CCS_PUBLIC_MCP_URL=
# 会话 cookie 的 Secure 标记。默认跟随 CCS_ENV；production 不允许显式关闭。
# 本地走 http 时置真会让 cookie 存不下来，症状是「登录成功但立刻跳回登录页」
CCS_WEB_SECURE_COOKIE=
# 每个“客户端 IP + 账号”在固定窗口内的登录尝试上限；同 IP 总上限为其 6 倍。
# key 只保存 SHA-256，不把账号或地址写进 Redis。Redis 故障时退回进程内计数。
CCS_LOGIN_RATE_LIMIT=10
CCS_LOGIN_RATE_WINDOW_SEC=900
# `verify-mysql-backup.sh --status-file` 写出的有界回执；留空则系统页显示未接入。
CCS_BACKUP_STATUS_FILE=
CCS_RESTORE_STATUS_FILE=
# `-check-integrity` 原子写入，正常服务只读；默认每天检查时允许跨过一次 24h 周期与调度抖动。
CCS_INTEGRITY_STATUS_FILE=
CCS_INTEGRITY_MAX_AGE_SEC=90000
# Web 管理员只能摄取这个目录树下面的 Markdown；留空则关闭 Web 摄取
CCS_INGEST_ROOT=

# ---- 密码哈希（argon2id）----
# 参数属于配置：该配多大取决于机器内存与能容忍的登录延迟。
# 调高之后存量用户仍能登录——参数编码在每个 hash 串里
CCS_ARGON2_MEMORY_KIB=19456
CCS_ARGON2_ITERATIONS=2
CCS_ARGON2_PARALLELISM=1

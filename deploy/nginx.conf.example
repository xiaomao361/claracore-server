# 放进目标站点的 server {} 中，并把域名、证书路径按本机环境补齐。
# ClaraCore 本体只监听 127.0.0.1:51890，不直接暴露公网端口。
# 这些 server 级超时与应用 listener 配套，应用内仍有不可绕过的硬边界。
server_tokens off;
client_header_timeout 10s;
client_body_timeout 30s;
keepalive_timeout 75s;
send_timeout 60s;

location /mcp {
	client_max_body_size 4m;
    proxy_pass http://127.0.0.1:51890;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_cache off;
    proxy_set_header Connection '';
    # MCP SDK 会对 loopback listener 启用 DNS rebinding 防护。
    proxy_set_header Host 127.0.0.1;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    chunked_transfer_encoding on;
	proxy_read_timeout 300s;
	proxy_send_timeout 300s;
}

# 指标在独立 loopback listener；公网入口明确拒绝，避免未来 location 改动误暴露。
location = /metrics {
    return 404;
}

location / {
	client_max_body_size 1m;
    proxy_pass http://127.0.0.1:51890;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_read_timeout 60s;
}

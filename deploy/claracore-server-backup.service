[Unit]
Description=ClaraCore Server MySQL backup
Documentation=file:///opt/claracore-server/current/DEPLOYMENT.md
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=oneshot
User=claracore
Group=claracore
UMask=0077
Environment=CCS_BACKUP_DATABASE=claracore_server
ExecStart=/opt/claracore-server/current/backup-mysql.sh --defaults-file /etc/claracore-server/mysql-backup.cnf --database ${CCS_BACKUP_DATABASE} --output-dir /var/backups/claracore-server
ExecStartPost=/opt/claracore-server/current/verify-mysql-backup.sh --backup-dir /var/backups/claracore-server --database ${CCS_BACKUP_DATABASE} --max-age-seconds 93600 --status-file /var/lib/claracore-server/backup-status.json

# 该任务只需读取 release/凭据并写入专用备份目录；不会自动删除历史备份。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/claracore-server /var/lib/claracore-server
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

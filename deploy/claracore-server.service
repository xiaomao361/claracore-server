[Unit]
Description=ClaraCore Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=claracore
Group=claracore
WorkingDirectory=/var/lib/claracore-server
EnvironmentFile=/etc/claracore-server/claracore-server.env
ExecStart=/opt/claracore-server/current/claracore-server
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
KillSignal=SIGTERM

# 单二进制服务无需写系统目录；摄取根目录只需读权限。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/claracore-server

[Install]
WantedBy=multi-user.target

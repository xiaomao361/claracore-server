# Merge these entries into the existing Prometheus configuration on the same
# host. Do not replace an organization's routing, retention, or Alertmanager
# settings with this example.
global:
  scrape_interval: 15s
  evaluation_interval: 30s

rule_files:
  - /etc/prometheus/claracore-server.rules.yml

scrape_configs:
  - job_name: claracore-server
    static_configs:
      - targets:
          - 127.0.0.1:51892

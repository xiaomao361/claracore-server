# 安装为 /etc/claracore-server/claracore-server.env，权限 0600。
# 不要把真实密码提交进仓库或 release 包。
CCS_ENV=production
CCS_ADDR=127.0.0.1:51890
# 多实例时必须逐实例改成唯一的公开安全标签；单实例可留空。
CCS_INSTANCE_ID=
# SIGTERM 后给负载均衡摘流的窗口；允许 0..60 秒，生产建议至少覆盖一次健康检查周期。
CCS_SHUTDOWN_DRAIN_SEC=5
# 类型化值严格解析并校验范围；配置拼写错误时服务会拒绝启动，不会静默使用默认值。
CCS_HTTP_READ_HEADER_TIMEOUT_SEC=10
CCS_HTTP_READ_TIMEOUT_SEC=30
CCS_HTTP_WRITE_TIMEOUT_SEC=300
CCS_HTTP_IDLE_TIMEOUT_SEC=120
CCS_HTTP_MAX_HEADER_BYTES=65536
CCS_WEB_MAX_FORM_BYTES=1048576
# 管理员团队导出的单次 ZIP 上限；完整生成后才开始响应，避免半包冒充成功。
CCS_EXPORT_MAX_BYTES=1073741824
CCS_MCP_MAX_BODY_BYTES=4194304
# 认证后先按 agent、再按租户总量限制调用；Redis 故障时退回每实例有界计数。
CCS_MCP_RATE_LIMIT=300
CCS_MCP_TENANT_RATE_LIMIT=3000
CCS_MCP_RATE_WINDOW_SEC=60
# 本机 Prometheus 抓取端点；配置校验拒绝非 loopback 地址和业务监听端口。
CCS_METRICS_ADDR=127.0.0.1:51892

CCS_MYSQL_HOST=127.0.0.1
CCS_MYSQL_PORT=3306
CCS_MYSQL_USER=claracore
CCS_MYSQL_PASSWORD=
CCS_MYSQL_DATABASE=claracore_server
# 同机 loopback 可 disabled；远程 MySQL 在 production 必须 verify-full。
# 私有 CA 可填绝对路径；客户端 CERT/KEY 可选且必须成对，私钥须 0600。
CCS_MYSQL_TLS_MODE=disabled
CCS_MYSQL_TLS_CA_FILE=
CCS_MYSQL_TLS_CERT_FILE=
CCS_MYSQL_TLS_KEY_FILE=
CCS_MYSQL_TLS_SERVER_NAME=
# 连接池上限 1..10000；按实际数据库容量调整，不要靠隐藏的无限连接兜底。
CCS_MYSQL_MAX_OPEN_CONNS=25
CCS_MYSQL_MAX_IDLE_CONNS=5
CCS_MYSQL_CONN_MAX_LIFETIME_SEC=1800

CCS_REDIS_ADDR=
CCS_REDIS_PASSWORD=
CCS_REDIS_PREFIX=ccs:
# 远程 Redis 在 production 必须 verify-full；同机 loopback 可 disabled。
CCS_REDIS_TLS_MODE=disabled
CCS_REDIS_TLS_CA_FILE=
CCS_REDIS_TLS_CERT_FILE=
CCS_REDIS_TLS_KEY_FILE=
CCS_REDIS_TLS_SERVER_NAME=

# disabled 可先完成全文检索部署；启用语义检索时再填真实服务。
CCS_EMBEDDING_PROVIDER=disabled
CCS_EMBEDDING_BASE_URL=
CCS_EMBEDDING_MODEL=
CCS_EMBEDDING_API_KEY=
CCS_EMBEDDING_CACHE_ENTRIES=1024
CCS_EMBEDDING_CACHE_TTL_SEC=86400

# 自动上下文确定性预筛。替换 embedding 模型后应先跑质量评估再调阈值。
CCS_AUTO_CONTEXT_MIN_SCORE=0.55
CCS_AUTO_CONTEXT_MIN_MARGIN=0.03

# 可选 Atlas 活源。URL 留空即关闭；token 只放本 0600 文件，不进数据库。
# production 中非 loopback URL 必须为 HTTPS，不取决于是否配置 token。当前只生成只读元数据/向量镜像。
CCS_ATLAS_MCP_URL=
CCS_ATLAS_MCP_TOKEN=
CCS_ATLAS_SYSTEM=
CCS_ATLAS_SOURCE_NAME=atlas-docs
CCS_ATLAS_SPACE_ID=
CCS_ATLAS_SYNC_INTERVAL_SEC=900
CCS_ATLAS_SYNC_TIMEOUT_SEC=600
CCS_ATLAS_TIMEOUT_SEC=30
CCS_ATLAS_PAGE_SIZE=100
CCS_ATLAS_MAX_WIRE_BYTES=8388608
CCS_ATLAS_MAX_BODY_BYTES=2097152

CCS_PUBLIC_MCP_URL=https://claracore.example.com/mcp
# production 必须为 true，且上面的公开地址必须使用 https。
CCS_WEB_SECURE_COOKIE=true
CCS_LOGIN_RATE_LIMIT=10
CCS_LOGIN_RATE_WINDOW_SEC=900
# systemd 备份 verifier 原子写入；只含归档名、时间与完整性结果，不含数据或凭据。
CCS_BACKUP_STATUS_FILE=/var/lib/claracore-server/backup-status.json
# 隔离恢复环境成功回传的技术恢复回执；不包含数据、凭据或临时库名。
CCS_RESTORE_STATUS_FILE=/var/lib/claracore-server/restore-status.json
# 每日只读关系检查原子写入；系统页、指标与告警只读取这个有界回执，不在请求路径扫描全库。
CCS_INTEGRITY_STATUS_FILE=/var/lib/claracore-server/integrity-status.json
CCS_INTEGRITY_MAX_AGE_SEC=90000

# Web 管理员唯一可扫描的 Markdown 根目录；留空关闭 Web 导入。
CCS_INGEST_ROOT=/srv/claracore-ingest

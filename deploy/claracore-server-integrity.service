[Unit]
Description=ClaraCore Server data integrity check
Documentation=file:///opt/claracore-server/current/DEPLOYMENT.md
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=oneshot
User=claracore
Group=claracore
UMask=0077
WorkingDirectory=/var/lib/claracore-server
EnvironmentFile=/etc/claracore-server/claracore-server.env
ExecStart=/opt/claracore-server/current/claracore-server -check-integrity

# The command reads MySQL in one repeatable-read read-only snapshot and only
# atomically replaces its bounded status receipt on the local filesystem.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/claracore-server
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
